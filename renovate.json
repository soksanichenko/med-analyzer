{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Kyiv",
  "schedule": [
    "* * * * 0,6"
  ],
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "7 days",
  "enabledManagers": [
    "dockerfile"
  ],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Majors always get their own PR and a label",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ]
    },
    {
      "description": "almalinux:10 is the rolling tag of the latest EL10 point release on purpose; Renovate would pin it to a point release",
      "matchDepNames": [
        "almalinux"
      ],
      "enabled": false
    }
  ]
}
